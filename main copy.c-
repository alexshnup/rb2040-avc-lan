#include <stdio.h>
#include "pico/stdlib.h"
#include "hardware/pio.h"
#include "hardware/clocks.h"
#include "avc_lan_capture.pio.h" // Включаем сгенерированный заголовочный файл

#define CAPTURE_PIN 2  // Пин, подключенный к AVC-LAN через делитель напряжения
#define LED_PIN 28 // LED

// void avc_lan_capture_program_init(PIO pio, uint sm, uint offset, uint pin);


int main() {
    stdio_init_all();

    // gpio_init(LED_PIN);
    // gpio_set_dir(LED_PIN, GPIO_OUT);

    // Инициализация PIO
    PIO pio = pio0;
    uint sm = pio_claim_unused_sm(pio, true);
    uint offset = pio_add_program(pio, &avc_lan_capture_program);
    pio_gpio_init(pio, CAPTURE_PIN);
    pio_gpio_init(pio, LED_PIN);

    // Настройка пина 2 как вход
    gpio_set_dir(CAPTURE_PIN, GPIO_IN);

    // Настройка пина 28 как выход через side-set
    pio_sm_set_consecutive_pindirs(pio, sm, LED_PIN, 1, true);

    avc_lan_capture_program_init(pio, sm, offset, CAPTURE_PIN);

    // Загрузка конфигурации в state machine
    pio_sm_config c = avc_lan_capture_program_get_default_config(offset);
    sm_config_set_in_pins(&c, CAPTURE_PIN);  // Установка пина 2 как источника данных
    sm_config_set_sideset_pins(&c, LED_PIN);  // Установка пина 28 как side-set пина
    sm_config_set_out_shift(&c, false, true, 32);  // Не сдвигать данные на выходе, передача прямо из X

    // Инициализация и запуск state machine
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);

    // // Ждем подключения USB
    // while (!stdio_usb_connected()) {
    //     sleep_ms(100);
    // }

	// // После avc_lan_capture_program_init(...)
	// if (!pio_sm_is_enabled(pio, sm)) {
	// 	printf("State machine не запущена\n");
	// } else {
	// 	printf("State machine успешно запущена\n");
	// }

    // printf("Начало захвата данных с AVC-LAN\n");



    // // Ждем подключения USB
    // while (!stdio_usb_connected()) {
    //     sleep_ms(100);
    // }

    // printf("Начало захвата данных с AVC-LAN\n");

    uint32_t loop_counter = 0;

    while (true) {

        // loop_counter++;
        // if (loop_counter % 1000000 == 0) {
        //     printf("Цикл работает, loop_counter: %u\n", loop_counter);
        // }

        // Проверяем, есть ли данные в FIFO
        if (!pio_sm_is_rx_fifo_empty(pio, sm)) {
            // printf("Start bit detected\n");
            // gpio_put(LED_PIN, 1);  // Включаем светодиод
            // sleep_ms(500);         // Светодиод горит 500 мс
            // gpio_put(LED_PIN, 0);  // Выключаем светодиод
            // sleep_ms(500);         // Светодиод горит 500 мс

            uint32_t data = pio_sm_get(pio, sm);
			if (data != 0) {  // Добавляем проверку на ноль
				// printf("Получено: 0x%08x\n", data);

			}

        }
    }


    return 0;
}

