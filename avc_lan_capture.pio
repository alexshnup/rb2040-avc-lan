.pio_version 0 // only requires PIO version 0

.program differential_manchester_tx
.side_set 2 opt

public start:

main_loop:
    ; nop side 0b10 [1]
    ; Ждём, пока в FIFO придут данные (одно слово)
    pull block
    
    ; Задаём, сколько раз хотим повторять "стартовый бит".
    ; Допустим, N=5 (или 10, 20 — на ваше усмотрение)
    set x, 12
    ; set x, 30

    ; Переходим вставлять "стартовый бит" (длинный импульс)
    jmp start_bit_loop


start_bit_loop:
    ; nop side 0b01 [1] => держим side=0b01 (к примеру) 1 такт задержки
    nop side 0b01
    nop side 0b01
    nop side 0b01
    
    ; jmp x-- start_bit_loop => прыгаем, пока x не уменьшится до -1
    jmp x-- start_bit_loop

    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail

start_send_data:
    out x, 1
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    jmp !x do_zero

do_one:
    ; x = 1  => прямой=1, инверт=0
    ; side=0b01 (в двоичной "01") => pin0=1, pin1=0
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    jmp start_send_data  side 0b10 ; Переходим, одновременно указываем Preparation time

do_zero:
    ; x = 0  => прямой=0, инверт=1
    ; side=0b10 (в двоичной "10") => pin0=0, pin1=1
    nop        side 0b01 ; T_data
    nop        side 0b01 ; T_data
    nop        side 0b01 ; T_data
    jmp start_send_data  side 0b10 ; Переходим, одновременно указываем Preparation time

public stop:


% c-sdk {
static inline void differential_manchester_tx_program_init(PIO pio, uint sm, uint offset, uint pin, float div) {
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, true);
    // pio_sm_set_pins_with_mask(pio, sm, 0, 1u << pin);

    // Можно сразу сбросить в 0, если хотим, чтобы при старте они были низкими
    // pio_sm_set_pins_with_mask(pio, sm, 0,
    //                           (1u << pin) | (1u << (pin + 1)));

    // выставим «дифференциальные» уровни уже на старте, ещё до того, как PIO-программа начнёт ими управлять.
    uint32_t pin_values = (1u << (pin + 1));
    uint32_t pin_mask   = (1u << pin) | (1u << (pin + 1));
    pio_sm_set_pins_with_mask(pio, sm, pin_values, pin_mask);

    pio_sm_config c = differential_manchester_tx_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, true, true, 8);
    //sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset + differential_manchester_tx_offset_start, &c);

    // Execute a blocking pull so that we maintain the initial line state until data is available
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_set_enabled(pio, sm, false);
}
%}

.program differential_manchester_rx
; .side_set 1 opt

public start:
; We mark wrap boundaries so the code loops from .wrap back to .wrap_target
.wrap_target
main:
    ; Wait for pin to be HIGH
wait_for_rise:
    jmp pin, got_rise     ; If pin == 1, jump
    jmp wait_for_rise     ; Otherwise keep waiting

got_rise:
    set x, 0
    mov x, ~x    ; x = 0xFFFFFFFF

count_high:
    jmp pin, keep_counting_high  ; If pin == 1, keep counting
    jmp got_fall                 ; If pin == 0, we're done measuring high
keep_counting_high:
    jmp x--, count_high          ; Decrement X each iteration

got_fall:
    mov x, ~x    ; x = ~x => 0xFFFFFFFF - original
    mov isr, x
    push noblock

    ; Wait for pin to be LOW
wait_for_fall:
    jmp pin, wait_for_fall  ; If pin == 1, stay here (still high)
    ; Once we fall through, pin==0 => measure LOW
    set x, 0
    mov x, ~x

count_low:
    jmp pin, got_rise2           ; If pin==1, done measuring low
    jmp x--, count_low

got_rise2:
    mov x, ~x
    mov isr, x
    push noblock

    jmp main
.wrap

