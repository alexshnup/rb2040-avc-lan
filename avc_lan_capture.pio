.pio_version 0 // only requires PIO version 0

.program avc_lan_tx
.side_set 2 opt

public start:

main_loop:
    ; nop side 0b10 [1]
    ; Wait until data (one word) arrives in FIFO
    pull block
    
    ; Set how many times we want to repeat the "start bit".
    ; For example, N=5 (or 10, 20 — at your discretion)
    set x, 31
    ; set x, 30

    ; Proceed to insert the "start bit" (long pulse)
    jmp start_bit_loop


start_bit_loop:
    ; nop side 0b01 [1] => maintain side=0b01 (for example) for 1 cycle delay
    nop side 0b01
    nop side 0b01
    nop side 0b01
    
    ; jmp x-- start_bit_loop => jump back while x is not decremented to -1
    jmp x-- start_bit_loop

    nop side 0b10 [2]  ; Start bit Tail
    nop side 0b10 [2]  ; Start bit Tail
    nop side 0b10 [2]  ; Start bit Tail
    nop side 0b10 [2]  ; Start bit Tail
    nop side 0b10 [2] ; Start bit Tail

start_send_data:
    out x, 1
    nop        side 0b01 [2] ; T_sync
    nop        side 0b01 [2] ; T_sync
    nop        side 0b01 [2] ; T_sync
    nop        side 0b01 [2] ; T_sync
    nop        side 0b01 [2] ; T_sync
    ; nop        side 0b01 [2] ; T_sync
    jmp !x do_zero

do_one:
    ; x = 1  => direct=1, inverted=0
    ; side=0b01 (binary "01") => pin0=1, pin1=0
    nop        side 0b10 [2] ; T_data
    nop        side 0b10 [2] ; T_data
    nop        side 0b10 [2] ; T_data
    ; nop        side 0b10 [1] ; T_data
    jmp start_send_data  side 0b10 [3]; Jump, simultaneously indicating Preparation time

do_zero:
    ; x = 0  => direct=0, inverted=1
    ; side=0b10 (binary "10") => pin0=0, pin1=1
    nop        side 0b01 [2] ; T_data
    nop        side 0b01 [2] ; T_data
    nop        side 0b01 [1] ; T_data
    jmp start_send_data  side 0b10 [3]; Jump, simultaneously indicating Preparation time

public stop:


% c-sdk {
static inline void avc_lan_tx_program_init(PIO pio, uint sm, uint offset, uint pin, float div) {
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, true);
    // pio_sm_set_pins_with_mask(pio, sm, 0, 1u << pin);

    // You can reset them to 0 immediately if you want them low at start
    // pio_sm_set_pins_with_mask(pio, sm, 0,
    //                           (1u << pin) | (1u << (pin + 1)));

    // Set "differential" levels already at the start, even before the PIO program takes control.
    uint32_t pin_values = (1u << (pin + 1));
    uint32_t pin_mask   = (1u << pin) | (1u << (pin + 1));
    pio_sm_set_pins_with_mask(pio, sm, pin_values, pin_mask);

    pio_sm_config c = avc_lan_tx_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, true, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset + avc_lan_tx_offset_start, &c);

    // Execute a blocking pull so that we maintain the initial line state until data is available
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_set_enabled(pio, sm, false);
}
%}

.program avc_lan_rx
; 
; Parameters/constants
;
.define MAX_COUNT      31            
.define THRESHOLD      16           ; Conditional threshold (in "loop iterations")
; Parameters (if desired, you can use .define etc.)
; For example, we want to push bytes (8 bits).
; .shift_right 0        ; shift ISR right on IN command
; .autopush     true
; .push_thresh  8       ; push to FIFO when ISR accumulates 8 bits

; Here we assume we're measuring the signal on pin 0
; (choose the desired input pin number and configure it in the C code).

.wrap_target
; ------------------------------------------------------------------------
; Wait until the pin BECOMES 0 (i.e., wait for a transition to 0)
; ------------------------------------------------------------------------
start:
    wait 1 pin 0   ; wait until pin is 1
wait_while_high:
    ; wait 1 pin 0   ; wait until pin is 1
    wait 0 pin 0   ; wait until pin falls to 0
                   ; as soon as it falls — proceed to measure_low

; ------------------------------------------------------------------------
; Prepare X for a "long" counter
; ------------------------------------------------------------------------
    set x, MAX_COUNT
    ; mov x, ~x       ; X ~ 0xFFFFFFE0 (~0xFFFFFFFF, but slightly less)

; ------------------------------------------------------------------------
; measure_low — loop while input is 0, decrementing X
; If input rises to 1 — go to measure_done
; If X "runs out" (becomes 0), then timeout => go to measure_timeout
; ------------------------------------------------------------------------
measure_low:
    jmp pin measure_done   ; if pin=1, then the "low pulse" ended
    jmp x-- measure_low    ; if pin=0 and x != 0 — keep looping
    ; if x reaches 0 => fall through (jmp x-- will not jump)
measure_timeout:
    ; Timeout detected: pulse too long.
    push noblock         ; Send current ISR contents to FIFO without blocking.
    ; Here we clear accumulated bits in ISR.
    set y, 0         ; load 0 into register Y
    mov isr, y       ; move 0 into ISR, clear accumulated bits
timeout_wait_for_high:
    jmp pin timeout_done    ; if pin=1 — exit timeout
    jmp timeout_wait_for_high
timeout_done:
    ; Return to waiting for a NEW transition to 0
    jmp wait_while_high

; ------------------------------------------------------------------------
; If we reached here — we saw that pin=1 => low pulse ended.
; Some value remains in X. Compare with THRESHOLD using Y.
; ------------------------------------------------------------------------
measure_done:
    set y, THRESHOLD
    ; mov y, ~y       ; THRESHOLD conditional, ~10 = 0xFFFFFFF5

compare_loop:
    jmp x-- x_still_nonzero
    ; => x=0 => means X < THRESHOLD => write 0
store_bit_0:
    in null, 1
    jmp bit_stored

x_still_nonzero:
    jmp y-- compare_loop
    ; => if y==0 (before x), then X >= THRESHOLD => write 1
store_bit_1:
    set x, 1
    in x, 1

bit_stored:
    ; Proceed to waiting for high level, because by condition
    ; "between bytes you need to wait for 1". But now it's already 1.
    ; We can immediately jump to wait_while_high to wait
    ; for the next "new" low phase to begin.
    ; BUT! pin is already 1, so we need to wait until 
    ; it becomes 0 again => no problem — we'll do that.
    jmp wait_while_high

.wrap

; End of program


% c-sdk {
static inline void avc_lan_rx_program_init(PIO pio, uint sm, uint offset, uint pin, float div) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);

    pio_sm_config c = avc_lan_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin); // for WAIT
    sm_config_set_jmp_pin(&c, pin); // for JMP
    ;// sm_config_set_in_shift(&c, true, true, 32);
    sm_config_set_in_shift(&c, false, true, 8);
    ;// sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);

    ;// X and Y are set to 0 and 1, to conveniently emit these to ISR/FIFO.
    ;// pio_sm_exec(pio, sm, pio_encode_set(pio_x, 1));
    ;// pio_sm_exec(pio, sm, pio_encode_set(pio_y, 0));
    pio_sm_set_enabled(pio, sm, true);
}
%}
