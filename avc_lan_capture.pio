.program avc_lan_capture

; Захватывает входящие биты с пина и сохраняет их в RX FIFO
; Захватывает входящие биты с пина и не сохраняет их в RX FIFO

loop:
    in pins, 1      ; Считываем значение пина (1 бит)
    ; push block      ; Отправляем данные в FIFO
    jmp loop        ; Повторяем цикл

