.pio_version 0 // only requires PIO version 0

.program avc_lan_tx
.side_set 2 opt

public start:

main_loop:
    ; nop side 0b10 [1]
    ; Ждём, пока в FIFO придут данные (одно слово)
    pull block
    
    ; Задаём, сколько раз хотим повторять "стартовый бит".
    ; Допустим, N=5 (или 10, 20 — на ваше усмотрение)
    set x, 12
    ; set x, 30

    ; Переходим вставлять "стартовый бит" (длинный импульс)
    jmp start_bit_loop


start_bit_loop:
    ; nop side 0b01 [1] => держим side=0b01 (к примеру) 1 такт задержки
    nop side 0b01
    nop side 0b01
    nop side 0b01
    
    ; jmp x-- start_bit_loop => прыгаем, пока x не уменьшится до -1
    jmp x-- start_bit_loop

    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail
    nop side 0b10  ; Start bit Tail

start_send_data:
    out x, 1
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    nop        side 0b01 ; T_sync
    jmp !x do_zero

do_one:
    ; x = 1  => прямой=1, инверт=0
    ; side=0b01 (в двоичной "01") => pin0=1, pin1=0
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    nop        side 0b10 ; T_data
    jmp start_send_data  side 0b10 ; Переходим, одновременно указываем Preparation time

do_zero:
    ; x = 0  => прямой=0, инверт=1
    ; side=0b10 (в двоичной "10") => pin0=0, pin1=1
    nop        side 0b01 ; T_data
    nop        side 0b01 ; T_data
    nop        side 0b01 ; T_data
    jmp start_send_data  side 0b10 ; Переходим, одновременно указываем Preparation time

public stop:


% c-sdk {
static inline void avc_lan_tx_program_init(PIO pio, uint sm, uint offset, uint pin, float div) {
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, true);
    // pio_sm_set_pins_with_mask(pio, sm, 0, 1u << pin);

    // Можно сразу сбросить в 0, если хотим, чтобы при старте они были низкими
    // pio_sm_set_pins_with_mask(pio, sm, 0,
    //                           (1u << pin) | (1u << (pin + 1)));

    // выставим «дифференциальные» уровни уже на старте, ещё до того, как PIO-программа начнёт ими управлять.
    uint32_t pin_values = (1u << (pin + 1));
    uint32_t pin_mask   = (1u << pin) | (1u << (pin + 1));
    pio_sm_set_pins_with_mask(pio, sm, pin_values, pin_mask);

    pio_sm_config c = avc_lan_tx_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, true, true, 8);
    //sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset + avc_lan_tx_offset_start, &c);

    // Execute a blocking pull so that we maintain the initial line state until data is available
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_set_enabled(pio, sm, false);
}
%}

.program avc_lan_rx

; 
; Параметры/константы
;
.define MAX_COUNT      30            
.define THRESHOLD      16           ; Условный порог (в «итерациях цикла»)
; Параметры (при желании можно оформить .define и т.п.)
; Допустим, хотим пушить байты (8 бит).
; .shift_right 0        ; сдвиг ISR вправо при команде IN
; .autopush     true
; .push_thresh  8       ; пушим в FIFO, когда ISR накопит 8 бит

; Здесь предполагаем, что измеряем сигнал на pin 0
; (выберите нужный вам номер входного пина и настройте его в C-коде).

.wrap_target
; ------------------------------------------------------------------------
; Ждём, пока пин НЕ станет 0 (то есть ждём события перехода в 0)
; ------------------------------------------------------------------------
start:
    wait 1 pin 0   ; дождаться, что pin в 1
wait_while_high:
    ; wait 1 pin 0   ; дождаться, что pin в 1
    wait 0 pin 0   ; дождаться, что pin упадёт в 0
                   ; как только упадёт — переходим к measure_low

; ------------------------------------------------------------------------
; Готовим X для «длинного» счётчика
; ------------------------------------------------------------------------
    set x, 31
    ; mov x, ~x       ; X ~ 0xFFFFFFE0 (~0xFFFFFFFF, но чуть меньше)

; ------------------------------------------------------------------------
; measure_low — крутимся, пока вход 0, уменьшая X
; если вход поднялся в 1 — переходим к measure_done
; если X «кончился» (стал 0), значит таймаут => идём в measure_timeout
; ------------------------------------------------------------------------
measure_low:
    jmp pin measure_done   ; если pin=1, значит «низкий импульс» кончился
    jmp x-- measure_low    ; если pin=0 и x != 0 — продолжаем крутиться
    ; если x достиг 0 => вываливаемся ниже (инструкция jmp x-- не выполнит переход)
measure_timeout:
    ; Обнаружен таймаут: импульс слишком длинный.
    ; Здесь очищаем накопленные биты в ISR.
    set y, 0         ; загружаем 0 в регистр Y
    mov isr, y       ; перемещаем 0 в ISR, очищаем накопленные биты
timeout_wait_for_high:
    jmp pin timeout_done    ; если pin=1 — выходим из таймаута
    jmp timeout_wait_for_high
timeout_done:
    ; Возвращаемся к ожиданию НОВОГО перехода в 0
    jmp wait_while_high

; ------------------------------------------------------------------------
; Если дошли сюда — значит мы увидели, что pin=1 => низкий импульс закончился.
; В X осталось некое значение. Сравниваем с THRESHOLD через Y.
; ------------------------------------------------------------------------
measure_done:
    set y, 16
    ; mov y, ~y       ; THRESHOLD условный, ~10 = 0xFFFFFFF5

compare_loop:
    jmp x-- x_still_nonzero
    ; => x=0 => значит X < THRESHOLD => пишем 0
store_bit_0:
    in null, 1
    jmp bit_stored

x_still_nonzero:
    jmp y-- compare_loop
    ; => если y==0 (раньше x), значит X >= THRESHOLD => пишем 1
store_bit_1:
    set x, 1
    in x, 1

bit_stored:
    ; Переходим к ожиданию верхнего уровня, т.к. по условию
    ; "между байтами нужно дождаться 1". Но сейчас он уже 1.
    ; Мы можем сразу перейти к wait_while_high, чтобы ждать
    ; когда следующая «новая» низкая фаза начнётся.
    ; НО! pin уже 1, значит нам надо дождаться, 
    ; когда он снова станет 0 => не проблема — так и сделаем.
    jmp wait_while_high

.wrap

; Конец программы


% c-sdk {
static inline void test_program_init(PIO pio, uint sm, uint offset, uint pin, float div) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);

    pio_sm_config c = test_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin); // for WAIT
    sm_config_set_jmp_pin(&c, pin); // for JMP
    ;// sm_config_set_in_shift(&c, true, true, 32);
    sm_config_set_in_shift(&c, false, true, 8);
    ;// sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);
    
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);

    ;// X and Y are set to 0 and 1, to conveniently emit these to ISR/FIFO.
    ;// pio_sm_exec(pio, sm, pio_encode_set(pio_x, 1));
    ;// pio_sm_exec(pio, sm, pio_encode_set(pio_y, 0));
    pio_sm_set_enabled(pio, sm, true);
}
%}